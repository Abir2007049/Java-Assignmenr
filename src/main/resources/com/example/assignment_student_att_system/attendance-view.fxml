<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" styleClass="root" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.assignment_student_att_system.controller.AttendanceController">
   <children>
      <!-- Controls Top Bar -->
      <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="stat-card">
         <children>
            <VBox spacing="4.0">
               <children>
                  <Label styleClass="stat-title" text="SELECT SUBJECT" />
                  <ComboBox fx:id="subjectComboBox" prefWidth="250.0" styleClass="combo-box" />
               </children>
            </VBox>

            <VBox spacing="4.0">
               <children>
                  <Label styleClass="stat-title" text="ATTENDANCE DATE" />
                  <DatePicker fx:id="datePicker" prefWidth="180.0" styleClass="date-picker" />
               </children>
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <Button onAction="#markAllPresent" styleClass="btn-secondary" text="✓ Mark All Present" />
            <Button onAction="#handleSaveAttendance" styleClass="btn-success" text="💾 Save Attendance" />
         </children>
      </HBox>

      <!-- Attendance Table -->
      <VBox styleClass="stat-card" VBox.vgrow="ALWAYS">
         <children>
            <TableView fx:id="attendanceTable" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colStudentId" prefWidth="120.0" text="Roll ID" />
                  <TableColumn fx:id="colStudentName" prefWidth="200.0" text="Student Name" />
                  <TableColumn fx:id="colStatus" prefWidth="260.0" text="Attendance Status" />
                  <TableColumn fx:id="colRemarks" prefWidth="240.0" text="Remarks" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>

            <HBox alignment="CENTER_LEFT" style="-fx-padding: 10 0 0 0;">
               <children>
                  <Label fx:id="statusSummaryLabel" style="-fx-font-weight: bold; -fx-fill: #94a3b8;" text="Total: 0  |  Present: 0  |  Absent: 0  |  Late: 0" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</VBox>
