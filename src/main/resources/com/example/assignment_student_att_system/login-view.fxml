<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="0.0" styleClass="root" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.assignment_student_att_system.controller.LoginController">
   <children>
      <VBox alignment="CENTER" maxWidth="420.0" spacing="20.0" styleClass="stat-card">
         <padding>
            <Insets bottom="35.0" left="35.0" right="35.0" top="35.0" />
         </padding>
         <children>
            <VBox alignment="CENTER" spacing="6.0">
               <children>
                  <Label styleClass="header-title" text="🎓 Attendance System" textFill="#6366f1">
                     <font>
                        <Font name="System Bold" size="24.0" />
                     </font>
                  </Label>
                  <Label styleClass="stat-title" text="Sign in to access your portal" />
               </children>
            </VBox>
            
            <VBox alignment="CENTER_LEFT" spacing="6.0">
               <children>
                  <Label styleClass="stat-title" text="Role" />
                  <ComboBox fx:id="roleComboBox" maxWidth="Infinity" styleClass="combo-box" />
               </children>
            </VBox>

            <VBox alignment="CENTER_LEFT" spacing="6.0">
               <children>
                  <Label styleClass="stat-title" text="Username" />
                  <TextField fx:id="usernameField" promptText="Enter username (e.g. admin)" styleClass="text-field" />
               </children>
            </VBox>

            <VBox alignment="CENTER_LEFT" spacing="6.0">
               <children>
                  <Label styleClass="stat-title" text="Password" />
                  <PasswordField fx:id="passwordField" promptText="Enter password" styleClass="text-field" />
               </children>
            </VBox>

            <Label fx:id="errorLabel" managed="false" style="-fx-text-fill: #ef4444; -fx-font-weight: bold;" text="Invalid credentials" visible="false" wrapText="true" />

            <Button maxWidth="Infinity" onAction="#handleLogin" styleClass="btn-primary" text="Sign In →">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Button>

            <HBox alignment="CENTER" spacing="12.0">
               <children>
                  <Button onAction="#fillAdminDemo" styleClass="btn-secondary" text="Demo Admin" />
                  <Button onAction="#fillTeacherDemo" styleClass="btn-secondary" text="Demo Teacher" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</VBox>
