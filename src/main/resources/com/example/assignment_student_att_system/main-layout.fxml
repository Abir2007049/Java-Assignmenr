<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane styleClass="root" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.assignment_student_att_system.controller.MainLayoutController">
   <left>
      <VBox prefWidth="240.0" spacing="10.0" styleClass="sidebar">
         <padding>
            <Insets bottom="20.0" left="15.0" right="15.0" top="20.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <padding>
                  <Insets bottom="15.0" left="10.0" right="10.0" top="5.0" />
               </padding>
               <children>
                  <Label styleClass="sidebar-title" text="🎓 AttendSys">
                     <font>
                        <Font name="System Bold" size="20.0" />
                     </font>
                  </Label>
               </children>
            </HBox>

            <VBox spacing="6.0" VBox.vgrow="ALWAYS">
               <children>
                  <Button fx:id="navDashboardBtn" maxWidth="Infinity" onAction="#showDashboard" styleClass="nav-btn-active" text="📊  Dashboard" />
                  <Button fx:id="navStudentsBtn" maxWidth="Infinity" onAction="#showStudents" styleClass="nav-btn" text="👨‍🎓  Students" />
                  <Button fx:id="navAttendanceBtn" maxWidth="Infinity" onAction="#showAttendance" styleClass="nav-btn" text="📋  Mark Attendance" />
                  <Button fx:id="navReportsBtn" maxWidth="Infinity" onAction="#showReports" styleClass="nav-btn" text="📈  Reports &amp; Logs" />
               </children>
            </VBox>

            <VBox spacing="10.0">
               <children>
                  <Button maxWidth="Infinity" onAction="#handleLogout" styleClass="btn-danger" text="🔒  Logout" />
               </children>
            </VBox>
         </children>
      </VBox>
   </left>

   <top>
      <HBox alignment="CENTER_LEFT" styleClass="header-bar">
         <children>
            <Label fx:id="headerTitleLabel" styleClass="header-title" text="Dashboard Overview" />
            <Region HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <Label styleClass="stat-title" text="Logged in as:" />
                  <Label fx:id="userLabel" style="-fx-font-weight: bold; -fx-text-fill: #6366f1;" text="Administrator" />
               </children>
            </HBox>
         </children>
      </HBox>
   </top>

   <center>
      <StackPane fx:id="contentArea">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </StackPane>
   </center>
</BorderPane>
